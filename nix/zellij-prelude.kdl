// Deprecated hand layout — use the `pin` command from packages.prelude instead:
//
//   pin            # shell-only workspace (Starship + ble + completions)
//   pin docs       # docs above shell
//   pin motd       # motd above shell
//
// `pin` starts Zellij with a frameless, locked config so shell keys reach
// ble/starship. Assets live in:
//   $prelude/share/prelude/zellij/{config.kdl,layouts/shell.kdl}
//
// Kept as a minimal fallback if you want to launch Zellij by hand:
//
//   zellij --config $(prelude path...)/share/prelude/zellij/config.kdl \
//          --layout  $(...)/share/prelude/zellij/layouts/shell.kdl

layout {
    pane borderless=true {
        // Prefer `prelude-shell` when on PATH (from packages.prelude).
        // Bare pane falls back to $SHELL without ble/starship init.
        focus true
    }
}
