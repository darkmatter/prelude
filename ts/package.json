{
  "name": "@drkmttr/prelude",
  "version": "0.2.0",
  "private": false,
  "description": "Prelude's command menu, MOTD, and docs viewer for Bun apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkmatter/prelude.git",
    "directory": "ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./lib/*"
  },
  "files": [
    "src",
    "lib"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../examples/typescript",
    "release": "release-it"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "release-it": "^21.1.0",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@21.1.0/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main",
      "tag": false,
      "tagName": "v${version}"
    },
    "github": {
      "autoGenerate": true,
      "release": true
    },
    "npm": {
      "allowSameVersion": true,
      "publish": false
    }
  }
}
