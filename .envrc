#!/usr/bin/env bash

# NOTE: do not set DIRENV_LOG_FORMAT here. `direnv export` decides how it logs
# before it runs this file, so setting it from inside .envrc cannot silence the
# load that is already in progress. It has to come from the user's own
# ~/.config/direnv/direnv.toml — see docs/welcome.md.

source_env_if_exists .envrc.local

# ----------------------------------------------------------------------------
# nix-direnv: direnv with better caching for nix
# ----------------------------------------------------------------------------
# shellcheck shell=bash
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi

# ----------------------------------------------------------------------------
# nix-direnv only watches flake.nix/flake.lock/.envrc by default; devshell
# behavior also lives in nix/*.nix and src/prelude/*.nix. Watch those so edits
# invalidate the cached profile instead of silently serving a stale env.
# ----------------------------------------------------------------------------
watch_file \
  nix/*.nix \
  nix/dogfood/*.nix \
  src/prelude/*.nix \
  src/prelude/options/*.nix \
  src/prelude/shell/*.bash

if has nix; then
  use flake
  # prelude-preflight prints the activation code for whatever shell evaluates
  # it. direnv runs .envrc non-interactively and sets DIRENV_IN_ENVRC, which is
  # the snippet's signal to have the init render the MOTD here instead of
  # sourcing its interactive-only path.
  if has prelude-preflight; then
    eval "$(prelude-preflight)"
  fi
else
  log_status "Nix is required. Install it here: https://install.determinate.systems"
fi
