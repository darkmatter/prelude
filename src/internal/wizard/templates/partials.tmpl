{{/* Shared partials for setup-generated Nix config.
    Commented defaults mirror src/prelude/defaults.nix — keep aligned. */}}

{{define "commandEntry"}}
{{ .Pad }}{{ .Key }} = {
{{- if .Exec }}
{{ .Pad }}  exec = {{ nixString .Exec }};  # defaults to the key suffix after the first colon
{{- else }}
{{ .Pad }}  # exec = {{ nixString .InferredExec }};  # defaults to the key suffix after the first colon
{{- end }}
{{- if .Description }}
{{ .Pad }}  description = {{ nixString .Description }};
{{- else }}
{{ .Pad }}  # description = "";
{{- end }}
{{- if .Group }}
{{ .Pad }}  # group inferred from key: {{ .Group }}  # first colon segment; builtins land in "prelude"
{{- end }}
{{- if .KeyAccel }}
{{ .Pad }}  key = {{ nixString .KeyAccel }};  # single-key accelerator (`x <key>`)
{{- else }}
{{ .Pad }}  # key = null;  # single-key accelerator (`x <key>`)
{{- end }}
{{- if .Usage }}
{{ .Pad }}  usage = {{ nixString .Usage }};  # usage form shown in menu details
{{- else }}
{{ .Pad }}  # usage = {{ nixString .InferredUsage }};  # usage form shown in menu details
{{- end }}
{{- if .Details }}
{{ .Pad }}  details = {{ nixString .Details }};  # extended description before arg entry
{{- else }}
{{ .Pad }}  # details = null;  # extended description before arg entry
{{- end }}
{{- if .Examples }}
{{ .Pad }}  examples = [
{{- range .Examples }}
{{ $.Pad }}    {{ nixString . }}
{{- end }}
{{ .Pad }}  ];  # worked example invocations
{{- else }}
{{ .Pad }}  # examples = [ {{ nixString .InferredUsage }} ];  # worked example invocations
{{- end }}
{{- if .Args }}
{{ .Pad }}  args = [
{{- range .Args }}
{{ $.Pad }}    { token = {{ nixString .Token }};{{ if .Description }} description = {{ nixString .Description }};{{ end }}{{ if .Required }} required = true;{{ end }}{{ if .Boolean }} boolean = true;{{ end }} }
{{- end }}
{{ .Pad }}  ];  # arg-entry mode
{{- else }}
{{ .Pad }}  # args = [ ];  # arg-entry mode: { token, description?, required?, boolean?, options? }
{{- end }}
{{- if .Invocation }}
{{ .Pad }}  invocation = {{ nixString .Invocation }};  # canonical shell text for duplicate detection
{{- else }}
{{ .Pad }}  # invocation = null;  # canonical shell text for duplicate detection; defaults to exec
{{- end }}
{{- if .MotdOrder }}
{{ .Pad }}  motd = {{ .MotdOrder }};  # MOTD Getting Started sort order; null hides from MOTD
{{- else }}
{{ .Pad }}  # motd = null;  # MOTD Getting Started sort order; null hides from MOTD
{{- end }}
{{ .Pad }}};
{{- end }}

{{/* Example command fields when the catalogue is empty (already under `# ` lines). */}}
{{define "commandFieldsCommented"}}
    #     # key = null;  # single-key accelerator (`x <key>`)
    #     # usage = null;  # usage form shown in menu details
    #     # details = null;  # extended description before arg entry
    #     # examples = [ ];  # worked example invocations
    #     # args = [ ];  # arg-entry mode: { token, description?, required?, boolean?, options? }
    #     # invocation = null;  # canonical shell text for duplicate detection; defaults to exec
    #     # motd = null;  # MOTD Getting Started sort order; null hides from MOTD
{{- end }}

{{/* Full motd = { … }; block (no leading indent). Used active or via commentLines. */}}
{{define "motdBlock"}}
motd = {
  enable = true;

{{ template "motdOptions" . -}}
};
{{- end }}

{{/* Body of motd options. Wizard-selected style fields are active; the rest
    remain commented defaults from defaults.nix. */}}
{{define "motdOptions"}}
      title = {
        text = {{ .TitlePath }};  # multiline title file; null uses the project-name wordmark
        align = {{ nixString .MotdStyle.TitleAlign }};  # left|center|right
        # style = "spine";  # wordmark when text is null: plain|spine|bracketed|label|inline|inverted
      };

      background = {{ .MotdStyle.Background }};  # block fill: false/true, a color, or a relative/blend value
      windowBackground = {{ .MotdStyle.WindowBackground }};  # full-width window fill
      border = {{ bool .MotdStyle.Border }};  # rounded frame around the block
      clearScreen = {{ bool .MotdStyle.ClearScreen }};  # clear the terminal before rendering
      align = {{ nixString .MotdStyle.Align }};  # horizontal placement: left|center|right
      verticalAlign = {{ nixString .MotdStyle.VerticalAlign }};  # vertical placement after clear: top|center|bottom
      width = {{ .MotdStyle.Width }};  # content width or "full"
      maxWidth = {{ .MotdStyle.MaxWidth }};  # maximum content width
      # fullscreen = false;  # fill terminal width with no cap (width=full + maxWidth=null)

      # Outer spacing selected by the wizard (sides may be added after setup).
      margin = {
        x = {{ .MotdStyle.MarginX }};
        y = {{ .MotdStyle.MarginY }};
        minHeight = {{ .MotdStyle.MarginMinHeight }};
        # top = null;      # supersedes y
        # bottom = null;   # supersedes y; gated by minHeight
        # left = null;     # supersedes x
        # right = null;    # supersedes x
      };

      # Inner spacing selected by the wizard (sides may be added after setup).
      padding = {
        x = {{ .MotdStyle.PaddingX }};
        y = {{ .MotdStyle.PaddingY }};
        minHeight = {{ .MotdStyle.PaddingMinHeight }};
        # top = null;
        # bottom = null;
        # left = null;
        # right = null;
      };

      # Hero: wizard-selected tagline and asynchronous status checks.
      header = {
        tagline = {
          text = {{ nixString .MotdContent.Tagline }};
          # subtitle = "";
          # layout = "stack";  # "stack" | "inline"
          # align = "left";  # "left" | "center"
        };
        # background = false;  # true = raised bar; null/false = transparent; color | { relative }
        # statusHint = {
        #   layout = "inline";  # "below" | "inline"
        #   links = [ ];  # terminal hyperlinks after the reload hint: { label, url }
        # };
        status = {
{{ if .MotdContent.NixFlakeCheck }}
          flake = {
            order = 10;
            label = "flake";
            check = "nix flake check";
            async = true;  # refresh in the background; shell entry stays fast
            # ok = "ok";
            # fail = "fail";
            # failLevel = "error";  # "error" | "warning"
            # output = "";  # "" | "light" | "diagnostic"
          };
{{ else }}
          # flake = { label = "flake"; check = "nix flake check"; async = true; };
{{ end }}
{{ if .MotdContent.DevServerStatus }}
          devServer = {
            order = 20;
            label = "dev server";
            check = {{ nixString .MotdContent.DevServerHealthCheck }};
            async = true;
          };
{{ else }}
          # devServer = { label = "dev server"; check = "curl -fsS \"\${APP_HOST:-http://127.0.0.1:3000}/health\""; async = true; };
{{ end }}
        };
      };

      # Styled text under the header; empty text hides it.
      description = {
        text = {{ nixString .MotdContent.Description }};
        # foreground = null;  # null uses the theme role color
        # background = null;  # null/false | true | color | { relative }
        # bold = false;
        # italic = false;
        # faint = false;
      };

      # links = [ ];  # terminal hyperlinks under the description: { label, url }
      # env = [  # info chips; each sets exactly one of value (static) or probe (command)
      #   { label = "node"; value = "22"; }
      #   { label = "pnpm"; value = "9"; }
      #   { label = "postgres"; value = "16"; }
      #   # { label = "nix"; probe = "nix --version | awk '{print $NF}'"; }
      # ];
      # recipes = {  # multi-step workflows keyed by name
      #   first-run = {
      #     order = 100;
      #     title = "spin up a clean local stack";
      #     steps = [
      #       { comment = "start services, migrate, then run the app"; }
      #       { command = "x database:up"; }
      #       { command = "x database:migrate"; }
      #       { command = "dev"; }
      #     ];
      #   };
      # };

      # Labels for the commands + examples region.
      # gettingStarted = {
      #   heading = "Getting Started";
      #   commandsLabel = "commands";
      #   examplesLabel = "examples";
      #   commandNote = "prefix with `x` if a command is shadowed";  # "" hides it
      # };
{{- end }}
